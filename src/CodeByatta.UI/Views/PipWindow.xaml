<Window x:Class="CodeByatta.UI.Views.PipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Picture in Picture"
        Width="420"
        Height="270"
        MinWidth="220"
        MinHeight="150"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="CanResize">

    <Border x:Name="WindowOuterBorder"
            Background="#0A0B0E"
            BorderBrush="#24262E"
            BorderThickness="1.5"
            CornerRadius="10"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.65" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header / Drag Bar -->
            <Grid Grid.Row="0"
                  Background="#121316"
                  MouseDown="Header_MouseDown"
                  MouseWheel="Header_MouseWheel"
                  Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock Text="🖼️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtTitle"
                               Text="PiP Stream"
                               Foreground="#FFFFFF"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Border x:Name="CroppedBadge"
                            Background="#D90078D7"
                            CornerRadius="3"
                            Padding="4,1"
                            Margin="6,0,0,0"
                            Visibility="Collapsed">
                        <TextBlock Text="CROPPED" FontSize="9" FontWeight="Bold" Foreground="White" />
                    </Border>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                    <!-- Interact Control Mode Toggle Button -->
                    <Button x:Name="BtnInteract"
                            ToolTip="Toggle Interactive Control (click &amp; control the live target window with mouse)"
                            Click="BtnInteract_Click"
                            Background="#1E30D158"
                            BorderBrush="#3330D158"
                            BorderThickness="1"
                            Padding="8,3"
                            Margin="0,0,6,0"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#30D158" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtInteract" Text="Control: ON" FontSize="10.5" FontWeight="Bold" Foreground="#30D158" />
                        </StackPanel>
                    </Button>

                    <!-- Restore / Return Original Window Button -->
                    <Button x:Name="BtnRestore"
                            ToolTip="Restore and Return to Original Window"
                            Click="BtnRestore_Click"
                            Background="#1A4CC2FF"
                            BorderBrush="#334CC2FF"
                            BorderThickness="1"
                            Padding="8,3"
                            Margin="0,0,6,0"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="↩" FontSize="11" Foreground="#4CC2FF" Margin="0,0,4,0" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="Return" FontSize="10.5" Foreground="#4CC2FF" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Close -->
                    <Button x:Name="BtnClose"
                            ToolTip="Close PiP and restore window"
                            Click="BtnClose_Click"
                            Background="#15FFFFFF"
                            BorderBrush="#25FFFFFF"
                            BorderThickness="1"
                            Padding="7,3"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="✕" FontSize="10" Foreground="#CCCCCC" FontWeight="Bold" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Thumbnail Client Area (DWM Renders Directly Here + User Mouse Clicks Forwarded) -->
            <Border Grid.Row="1"
                    x:Name="ThumbnailHost"
                    Background="#000000"
                    SizeChanged="ThumbnailHost_SizeChanged"
                    MouseDown="ThumbnailHost_MouseDown"
                    MouseUp="ThumbnailHost_MouseUp"
                    MouseMove="ThumbnailHost_MouseMove"
                    MouseWheel="ThumbnailHost_MouseWheel"
                    Cursor="Arrow" />
        </Grid>
    </Border>
</Window>
