<Window x:Class="CodeByatta.UI.Views.TopmostBorderOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Topmost Border Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize">

    <Border x:Name="OverlayBorder"
            BorderBrush="Red"
            BorderThickness="3"
            Background="{x:Null}"
            CornerRadius="4"
            IsHitTestVisible="False" />
</Window>
