<Window x:Class="CodeByatta.UI.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:ThemeManager.IsThemeAware="True"
        Title="New Update Available - OpenWindow"
        Width="520"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        Background="#18181A"
        Foreground="#EEEEEE"
        BorderBrush="#33FFFFFF"
        BorderThickness="1">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#44FFFFFF" />
            <Setter Property="Background" Value="#252528" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Width="44" Height="44" Background="#2630D158" BorderBrush="#6030D158" BorderThickness="1" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Text="🚀" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="New Version Available!" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" />
                <TextBlock x:Name="TxtVersionSummary" Text="OpenWindow update is ready" Foreground="#AAAAAA" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Version Comparison Badge -->
        <Border Grid.Row="1" Background="#202228" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Installed Version" FontSize="11" Foreground="#888888" />
                    <TextBlock x:Name="TxtCurrentVer" Text="v1.1.3" FontSize="14" FontWeight="SemiBold" Foreground="#CCCCCC" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="➔" FontSize="16" Foreground="#4CC2FF" VerticalAlignment="Center" Margin="10,0" />
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <TextBlock Text="Latest Release" FontSize="11" Foreground="#888888" HorizontalAlignment="Right" />
                    <TextBlock x:Name="TxtNewVer" Text="v1.2.0" FontSize="14" FontWeight="Bold" Foreground="#30D158" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Release Notes Section -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <DockPanel Margin="0,0,0,6">
                <TextBlock x:Name="TxtReleaseTitle" Text="Release Notes" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtAssetSize" Text="" FontSize="11" Foreground="#888888" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
            <Border Background="#121214" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10">
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtReleaseNotes" TextWrapping="Wrap" Foreground="#DDDDDD" FontSize="12" LineHeight="18" FontFamily="Segoe UI" />
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Download & Progress Area -->
        <StackPanel Grid.Row="3" x:Name="PnlProgress" Visibility="Collapsed" Margin="0,0,0,16">
            <ProgressBar x:Name="PrgDownload" Height="6" Minimum="0" Maximum="100" Value="0" Background="#26FFFFFF" Foreground="#30D158" Margin="0,0,0,6" />
            <DockPanel>
                <TextBlock x:Name="TxtProgressStatus" Text="Downloading update package..." FontSize="11" Foreground="#4CC2FF" />
                <TextBlock x:Name="TxtProgressPercent" Text="0%" FontSize="11" Foreground="#AAAAAA" HorizontalAlignment="Right" />
            </DockPanel>
        </StackPanel>

        <!-- Action Buttons -->
        <Grid Grid.Row="4" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="BtnViewGitHub" Content="View on GitHub ↗" Click="BtnViewGitHub_Click" Background="Transparent" BorderThickness="0" Foreground="#4CC2FF" FontSize="12" Padding="4,4" />

            <StackPanel Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnLater" Content="Later" Click="BtnLater_Click" Margin="0,0,8,0" Background="#28282C" />
                <Button x:Name="BtnUpdateNow" Content="⚡ Update Now (1-Click)" Click="BtnUpdateNow_Click" Background="#2E7D32" BorderBrush="#43A047" FontWeight="SemiBold" Foreground="White" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
