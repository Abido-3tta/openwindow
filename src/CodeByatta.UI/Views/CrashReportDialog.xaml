<Window x:Class="CodeByatta.UI.Views.CrashReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenWindow Diagnostics"
        Width="580"
        Height="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True">

    <Border Background="#16181F"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.8" Color="#000000" />
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="36" Height="36" CornerRadius="8" Background="#33FF3B30" Margin="0,0,14,0">
                    <Path Data="M12,2 L1,21 L23,21 Z M12,6 L14,14 L10,14 Z M12,17 A1.5,1.5 0 1,1 12,20 A1.5,1.5 0 1,1 12,17"
                          Fill="#FF3B30" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="OpenWindow Diagnostics" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="Diagnostic report from previous unexpected termination" FontSize="12" Foreground="#8E8E93" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Description -->
            <TextBlock Grid.Row="1"
                       Text="OpenWindow captured an unhandled exception. A structured crash dump has been preserved locally in your AppData directory. You can copy the diagnostic details below or send them to the developer."
                       TextWrapping="Wrap"
                       Foreground="#CBD5E1"
                       FontSize="12.5"
                       LineHeight="18"
                       Margin="0,0,0,14" />

            <!-- Diagnostics Details Viewer -->
            <Border Grid.Row="2"
                    Background="#0D0E12"
                    BorderBrush="#252730"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBox x:Name="TxtDiagnostics"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#E2E8F0"
                             FontFamily="Consolas, Cascadia Code, Courier New"
                             FontSize="11.5"
                             IsReadOnly="True"
                             TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <!-- Actions Footer -->
            <DockPanel Grid.Row="3">
                <Button x:Name="BtnCopy"
                        Content="📋 Copy Diagnostics"
                        Click="BtnCopy_Click"
                        Padding="14,8"
                        Background="#2A2D3A"
                        Foreground="#FFFFFF"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Margin="0,0,10,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnOpenFolder"
                        Content="📁 Open Folder"
                        Click="BtnOpenFolder_Click"
                        Padding="14,8"
                        Background="#1E202A"
                        Foreground="#CBD5E1"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnClose"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Content="Dismiss &amp; Continue"
                        Click="BtnClose_Click"
                        Padding="18,8"
                        Background="#0A84FF"
                        Foreground="#FFFFFF"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>
            </DockPanel>
        </Grid>
    </Border>
</Window>
