<Window x:Class="CodeByatta.UI.Views.TitleBarToolbarView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenWindow Toolbar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowActivated="False"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <!-- Windows 11 Fluent Polished Silver Slider Thumb -->
        <Style x:Key="FluentSilverSliderThumb" TargetType="{x:Type Thumb}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Width="16" Height="16">
                            <Ellipse Width="16" Height="16" Stroke="#FFFFFF" StrokeThickness="1.5">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0.0" />
                                        <GradientStop Color="#CBD5E1" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.5" Color="#000000" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="5" Height="5" Fill="#334155" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Fluent Slider Style with Silver / Titanium Track -->
        <Style x:Key="FluentSilverSlider" TargetType="{x:Type Slider}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <!-- Background Unfilled Track -->
                            <Border Height="4" CornerRadius="2" Background="#141720" BorderBrush="#3364748B" BorderThickness="0.8" VerticalAlignment="Center" Margin="4,0" />
                            <!-- Active Filled Track and Thumb -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="4" CornerRadius="2,0,0,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#64748B" Offset="0.0" />
                                                            <GradientStop Color="#E2E8F0" Offset="1.0" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource FluentSilverSliderThumb}" Cursor="Hand" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Pill Preset Button Style -->
        <Style x:Key="OpacityPresetPillButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#141519" />
            <Setter Property="Foreground" Value="#D1D5DB" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#20222A" BorderThickness="0.8" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22252F" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4A4E5E" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2D3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Obsidian Black Sleek Toolbar Button Style -->
        <Style x:Key="ToolbarPillButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#141519" />
            <Setter Property="BorderBrush" Value="#22242D" />
            <Setter Property="BorderThickness" Value="0.8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22252F" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3D4150" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2D3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <!-- 1. Collapsed Header Anchor Handle: 3D Frosted Obsidian Glass Aesthetic -->
        <Border x:Name="AnchorHandle"
                BorderThickness="1"
                CornerRadius="14"
                MinHeight="28"
                Padding="8,4,10,4"
                Cursor="Hand"
                ToolTip="Click to expand | Drag to reposition | Double-Click to Pin"
                MouseDown="AnchorHandle_MouseDown"
                MouseMove="AnchorHandle_MouseMove"
                MouseUp="AnchorHandle_MouseUp"
                MouseEnter="AnchorHandle_MouseEnter"
                MouseLeave="AnchorHandle_MouseLeave"
                Visibility="Collapsed">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F010121A" Offset="0.0" />
                    <GradientStop Color="#F808090C" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#45FFFFFF" Offset="0.0" />
                    <GradientStop Color="#18CBD5E1" Offset="1.0" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.65" Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Mini Move / Drag Grip Handle for Collapsed Anchor -->
                <Border x:Name="AnchorDragGrip"
                        ToolTip="Drag horizontally left/right along titlebar"
                        Background="Transparent"
                        Padding="0,0,7,0"
                        Cursor="SizeWE"
                        MouseDown="AnchorDragGrip_MouseDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M1,2 A1,1 0 1,1 1,4 A1,1 0 1,1 1,2 M1,7 A1,1 0 1,1 1,9 A1,1 0 1,1 1,7 M1,12 A1,1 0 1,1 1,14 A1,1 0 1,1 1,12"
                              Fill="#64748B" Width="3" Height="13" />
                        <Path Data="M1,2 A1,1 0 1,1 1,4 A1,1 0 1,1 1,2 M1,7 A1,1 0 1,1 1,9 A1,1 0 1,1 1,7 M1,12 A1,1 0 1,1 1,14 A1,1 0 1,1 1,12"
                              Fill="#64748B" Width="3" Height="13" Margin="1.5,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- 3D Minimalist Silver Layered Window Icon -->
                <Grid Width="16" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                    <!-- Layer 1: Back Base Window (Dark Titanium with subtle edge) -->
                    <Border Width="13" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Background="#222836" BorderThickness="0.8" CornerRadius="2">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#5594A3B8" Offset="0" />
                                <GradientStop Color="#22475569" Offset="1" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                    </Border>
                    <!-- Layer 2: Elevated Front Glass Window (Polished Silver / Platinum 3D Bevel) -->
                    <Border Width="13" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                            CornerRadius="2" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#33FFFFFF" Offset="0" />
                                <GradientStop Color="#18CBD5E1" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFFFF" Offset="0" />
                                <GradientStop Color="#A0CBD5E1" Offset="0.4" />
                                <GradientStop Color="#7094A3B8" Offset="1" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1.5" Direction="315" Opacity="0.6" Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <!-- Mini Titlebar Notch on Front Window -->
                            <Border Height="2.5" VerticalAlignment="Top" Background="#40FFFFFF" CornerRadius="1.5,1.5,0,0" />
                            <!-- Mini Window Glass Pane Cut -->
                            <Rectangle Width="3.5" Height="3" Fill="#60FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1.5,1.5" RadiusX="0.5" RadiusY="0.5" />
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock Text="OpenWindow" FontSize="11.5" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" Margin="0,0,7,0" />

                <!-- Silver Minimalist Chevron Down -->
                <Path x:Name="PathAnchorArrow"
                      Data="M0,1.5 L3.5,5 L7,1.5"
                      Stroke="#CBD5E1"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 2. Full Expanded Draggable Toolbar Pill: 3D Frosted Obsidian Glass Aesthetic -->
        <Border x:Name="FullToolbarPill"
                BorderThickness="1"
                CornerRadius="18"
                Padding="6,3"
                MouseEnter="FullToolbarPill_MouseEnter"
                MouseLeave="FullToolbarPill_MouseLeave"
                MouseDown="FullToolbarPill_MouseDown"
                MouseMove="FullToolbarPill_MouseMove"
                MouseUp="FullToolbarPill_MouseUp"
                Cursor="SizeWE"
                Visibility="Visible">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F20D0E13" Offset="0.0" />
                    <GradientStop Color="#FA08090C" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#40FFFFFF" Offset="0.0" />
                    <GradientStop Color="#15CBD5E1" Offset="1.0" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.70" Color="#000000" />
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Move / Drag Grip Handle -->
                <Border x:Name="DragGrip"
                        ToolTip="Drag horizontally left/right along the window titlebar"
                        Background="Transparent"
                        Padding="6,6"
                        Cursor="SizeWE"
                        MouseDown="DragGrip_MouseDown">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M1,2 A1,1 0 1,1 1,4 A1,1 0 1,1 1,2 M1,7 A1,1 0 1,1 1,9 A1,1 0 1,1 1,7 M1,12 A1,1 0 1,1 1,14 A1,1 0 1,1 1,12"
                              Fill="#646670" Width="4" Height="16" />
                        <Path Data="M1,2 A1,1 0 1,1 1,4 A1,1 0 1,1 1,2 M1,7 A1,1 0 1,1 1,9 A1,1 0 1,1 1,7 M1,12 A1,1 0 1,1 1,14 A1,1 0 1,1 1,12"
                              Fill="#646670" Width="4" Height="16" Margin="2,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- Pin / Always-on-Top Button -->
                <Button x:Name="BtnTopmost"
                        Style="{StaticResource ToolbarPillButton}"
                        ToolTip="Always-on-Top (Alt+Z) - Outlines window in red"
                        Click="BtnTopmost_Click">
                    <Grid VerticalAlignment="Center" Margin="2,0">
                        <!-- Pin Vector Path: Red when active, muted slate/grey when inactive -->
                        <Path x:Name="PathTopmostPin"
                              Data="M9,2 L7,4 L7,8 L4,11 L4,12 L8,12 L8,16 L9,17 L10,16 L10,12 L14,12 L14,11 L11,8 L11,4 L9,2 Z"
                              Fill="#8E8E93" Width="14" Height="15" Stretch="Uniform" />
                        <Ellipse x:Name="DotTopmost"
                                 Visibility="Collapsed" />
                    </Grid>
                </Button>

                <!-- Opacity Button / Percentage Display -->
                <Button x:Name="BtnOpacity"
                        Style="{StaticResource ToolbarPillButton}"
                        ToolTip="Transparency (Alt+A) - Hover to open, click to cycle, or scroll wheel"
                        Click="BtnOpacity_Click"
                        MouseEnter="BtnOpacity_MouseEnter"
                        MouseWheel="BtnOpacity_MouseWheel">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Layered Windows Vector Path -->
                        <Path Data="M0,4 A2,2 0 0,1 2,2 L10,2 A2,2 0 0,1 12,4 L12,12 A2,2 0 0,1 10,14 L2,14 A2,2 0 0,1 0,12 Z M4,0 A2,2 0 0,1 6,0 L14,0 A2,2 0 0,1 16,2 L16,10 A2,2 0 0,1 14,12"
                              Stroke="White" StrokeThickness="1.2" Fill="Transparent" Width="15" Height="14" Stretch="Uniform" />
                        <TextBlock x:Name="TxtOpacityPercent"
                                   Text="100%"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#EDEDED"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Hover Opacity Reveal Toggle Button (DisableWhenMouseAbove) -->
                <Button x:Name="BtnHoverOpacity"
                        Style="{StaticResource ToolbarPillButton}"
                        ToolTip="Hover Opacity Reveal: Auto-restore 100% opacity when mouse is over window body (Click to Toggle ON/OFF)"
                        Click="BtnHoverOpacity_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Eye Vector Path -->
                        <Path Data="M0,7 C2,2 10,2 12,7 C10,12 2,12 0,7 Z M6,4.5 A2.5,2.5 0 1,1 6,9.5 A2.5,2.5 0 1,1 6,4.5 Z"
                              Stroke="White" StrokeThickness="1.2" Fill="Transparent" Width="14" Height="13" Stretch="Uniform" />
                        <Ellipse x:Name="DotHoverOpacity"
                                 Width="6" Height="6"
                                 Fill="#30D158"
                                 Margin="4,0,0,0"
                                 Visibility="Visible" />
                    </StackPanel>
                </Button>

                <!-- Click-Through Toggle Button -->
                <Button x:Name="BtnClickThrough"
                        Style="{StaticResource ToolbarPillButton}"
                        ToolTip="Click-Through Mode (Alt+C) - Mouse passes through window. Click to disable!"
                        Click="BtnClickThrough_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Cursor Click Vector Path -->
                        <Path Data="M0,0 L0,14 L4,10 L7,16 L9,15 L6,9 L11,9 Z"
                              Fill="White" Width="12" Height="14" Stretch="Uniform" />
                        <TextBlock x:Name="TxtClickThroughStatus"
                                   Text="ON"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#30D158"
                                   Margin="4,0,0,0"
                                   Visibility="Collapsed" />
                        <Ellipse x:Name="DotClickThrough"
                                 Width="6" Height="6"
                                 Fill="#30D158"
                                 Margin="5,0,0,0"
                                 Visibility="Collapsed" />
                    </StackPanel>
                </Button>

                <Separator Width="1" Height="16" Margin="3,0" Background="#262832" />

                <!-- Picture-in-Picture Button -->
                <Button x:Name="BtnPip"
                        Style="{StaticResource ToolbarPillButton}"
                        ToolTip="Picture-in-Picture (Alt+Q) - Shrinks into live stream &amp; hides main window"
                        Click="BtnPip_Click">
                    <!-- PiP Screen in Screen Vector Path -->
                    <Path Data="M0,2 A2,2 0 0,1 2,0 L16,0 A2,2 0 0,1 18,2 L18,12 A2,2 0 0,1 16,14 L2,14 A2,2 0 0,1 0,12 Z M8,7 L16,7 L16,12 L8,12 Z"
                          Fill="White" Width="16" Height="13" Stretch="Uniform" />
                </Button>

                <!-- Crop to PiP Button -->
                <Button x:Name="BtnCrop"
                        Style="{StaticResource ToolbarPillButton}"
                        ToolTip="Crop Region to PiP - Select sub-rectangle to stream"
                        Click="BtnCrop_Click">
                    <!-- Crop Tool Vector Path -->
                    <Path Data="M4,0 L4,12 L16,12 M0,4 L12,4 L12,16"
                          Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
                </Button>

                <!-- Dark Mode Inversion Button -->
                <Button x:Name="BtnDarkMode"
                        Style="{StaticResource ToolbarPillButton}"
                        ToolTip="Inverted Dark Mode (Alt+D) - Hardware GPU color inversion"
                        Click="BtnDarkMode_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Crescent Moon Vector Path -->
                        <Path Data="M10,0 A8,8 0 1,1 0,10 A6,6 0 0,0 10,0 Z"
                              Fill="White" Width="13" Height="13" Stretch="Uniform" />
                        <Ellipse x:Name="DotDarkMode"
                                 Width="6" Height="6"
                                 Fill="#FFD60A"
                                 Margin="5,0,0,0"
                                 Visibility="Collapsed" />
                    </StackPanel>
                </Button>

                <!-- Cinema Focus (Dim Background) Button -->
                <Button x:Name="BtnCinemaFocus"
                        Style="{StaticResource ToolbarPillButton}"
                        ToolTip="Cinema Focus (Alt+F) - Dim background desktop and distraction windows"
                        Click="BtnCinemaFocus_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Cinema Projector / Focus Light Vector Path -->
                        <Path Data="M2,2 L14,2 L14,14 L2,14 Z M6,6 L10,6 L10,10 L6,10 Z"
                              Stroke="White" StrokeThickness="1.2" Fill="Transparent" Width="13" Height="13" Stretch="Uniform" />
                        <Ellipse x:Name="DotCinemaFocus"
                                 Width="6" Height="6"
                                 Fill="#BF5AF2"
                                 Margin="5,0,0,0"
                                 Visibility="Collapsed" />
                    </StackPanel>
                </Button>

                <Separator Width="1" Height="16" Margin="3,0" Background="#262832" />

                <!-- Settings Button (Directly on Toolbar!) -->
                <Button x:Name="BtnSettings"
                        Style="{StaticResource ToolbarPillButton}"
                        ToolTip="Open OpenWindow Settings Dashboard"
                        Click="BtnSettings_Click">
                    <!-- Gear Vector Path -->
                    <Path Data="M6.5,0 L8.5,0 L8.8,2.2 A6.5,6.5 0 0,1 10.3,3.1 L12.4,2.2 L13.8,3.6 L12.9,5.7 A6.5,6.5 0 0,1 13.8,7.2 L16,7.5 L16,9.5 L13.8,9.8 A6.5,6.5 0 0,1 12.9,11.3 L13.8,13.4 L12.4,14.8 L10.3,13.9 A6.5,6.5 0 0,1 8.8,14.8 L8.5,17 L6.5,17 L6.2,14.8 A6.5,6.5 0 0,1 4.7,13.9 L2.6,14.8 L1.2,13.4 L2.1,11.3 A6.5,6.5 0 0,1 1.2,9.8 L-1,9.5 L-1,7.5 L1.2,7.2 A6.5,6.5 0 0,1 2.1,5.7 L1.2,3.6 L2.6,2.2 L4.7,3.1 A6.5,6.5 0 0,1 6.2,2.2 Z M7.5,5.5 A3,3 0 1,0 7.5,11.5 A3,3 0 1,0 7.5,5.5 Z"
                          Fill="#4CC2FF" Width="13" Height="13" Stretch="Uniform" />
                </Button>

                <!-- Collapse to Header Handle Button -->
                <Button x:Name="BtnCollapse"
                        Style="{StaticResource ToolbarPillButton}"
                        ToolTip="Collapse to top header anchor"
                        Click="BtnCollapse_Click">
                    <!-- Chevron Up Vector -->
                    <Path Data="M0,4 L4,0 L8,4" Stroke="#AAAAAA" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                </Button>

                <!-- Dismiss Toolbar Button -->
                <Button x:Name="BtnClose"
                        Style="{StaticResource ToolbarPillButton}"
                        ToolTip="Dismiss toolbar for this window"
                        Click="BtnClose_Click">
                    <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#888888" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="8" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Horizontal Opacity Slider Popup (Windows 11 Volume / Brightness Style) -->
        <Popup x:Name="PopupOpacitySlider"
               PlacementTarget="{Binding ElementName=BtnOpacity}"
               Placement="Bottom"
               VerticalOffset="6"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade">
            <Border x:Name="PopupOpacityBorder"
                    Background="#FA0B0C0F"
                    BorderBrush="#262832"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12"
                    Width="250"
                    MouseEnter="PopupOpacityBorder_MouseEnter"
                    MouseLeave="PopupOpacityBorder_MouseLeave"
                    MouseWheel="PopupOpacityBorder_MouseWheel">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.8" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- Header with 3D Silver Icon & Percentage -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Mini Silver Layered Icon -->
                            <Grid Width="14" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Border Width="11" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        Background="#222836" BorderThickness="0.8" BorderBrush="#5594A3B8" CornerRadius="1.5" />
                                <Border Width="11" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="#2AFFFFFF" BorderThickness="0.8" BorderBrush="#CBD5E1" CornerRadius="1.5">
                                    <Border Height="2" VerticalAlignment="Top" Background="#55FFFFFF" CornerRadius="1,1,0,0" />
                                </Border>
                            </Grid>
                            <TextBlock Text="Window Opacity" FontSize="11" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="TxtSliderPercentBadge" Text="100%" FontSize="11.5" FontWeight="Bold" Foreground="#E2E8F0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Horizontal Slider (5 to 100%) with Fluent Silver Style & Instant Click-to-Point -->
                    <Slider Grid.Row="1"
                            x:Name="SliderOpacity"
                            Style="{StaticResource FluentSilverSlider}"
                            Minimum="5"
                            Maximum="100"
                            Value="100"
                            SmallChange="5"
                            LargeChange="10"
                            IsSnapToTickEnabled="False"
                            IsMoveToPointEnabled="True"
                            ValueChanged="SliderOpacity_ValueChanged"
                            Cursor="Hand"
                            Height="24"
                            Margin="0,0,0,10" />

                    <!-- Quick Preset Badges -->
