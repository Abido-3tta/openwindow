<Window x:Class="CodeByatta.UI.Views.TitleBarToolbarView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenWindow Toolbar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowActivated="False"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Grid Margin="2">
        <!-- 1. Collapsed Header Anchor Handle (Proportioned to Window Header Bar) -->
        <Border x:Name="AnchorHandle"
                Background="#EE1A1C24"
                BorderBrush="#6630D158"
                BorderThickness="1.5"
                CornerRadius="13"
                MinHeight="28"
                Padding="8,4,12,4"
                Cursor="Hand"
                ToolTip="Click to expand | Drag to reposition | Double-Click to Pin"
                MouseDown="AnchorHandle_MouseDown"
                MouseMove="AnchorHandle_MouseMove"
                MouseUp="AnchorHandle_MouseUp"
                MouseEnter="AnchorHandle_MouseEnter"
                MouseLeave="AnchorHandle_MouseLeave"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.6" Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Mini Move / Drag Grip Handle for Collapsed Anchor -->
                <Border x:Name="AnchorDragGrip"
                        ToolTip="Drag horizontally left/right along titlebar"
                        Background="Transparent"
                        Padding="0,0,6,0"
                        Cursor="SizeWE"
                        MouseDown="AnchorDragGrip_MouseDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M1,2 A1,1 0 1,1 1,4 A1,1 0 1,1 1,2 M1,7 A1,1 0 1,1 1,9 A1,1 0 1,1 1,7 M1,12 A1,1 0 1,1 1,14 A1,1 0 1,1 1,12"
                              Fill="#777777" Width="3" Height="13" />
                        <Path Data="M1,2 A1,1 0 1,1 1,4 A1,1 0 1,1 1,2 M1,7 A1,1 0 1,1 1,9 A1,1 0 1,1 1,7 M1,12 A1,1 0 1,1 1,14 A1,1 0 1,1 1,12"
                              Fill="#777777" Width="3" Height="13" Margin="1.5,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- Mini Logo Vector -->
                <Path Data="M0,2 A2,2 0 0,1 2,0 L12,0 A2,2 0 0,1 14,2 L14,10 A2,2 0 0,1 12,12 L2,12 A2,2 0 0,1 0,10 Z M2,3 L12,3 M7,6 L12,6 L12,10 L7,10 Z"
                      Stroke="#4CC2FF" StrokeThickness="1.3" Fill="Transparent" Width="14" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="OpenWindow" FontSize="11.5" FontWeight="SemiBold" Foreground="#EEEEEE" VerticalAlignment="Center" Margin="0,0,6,0" />
                <!-- Arrow / Chevron Down Vector (Matching WindowTop Arrow color) -->
                <Path x:Name="PathAnchorArrow"
                      Data="M0,1 L4,6 L8,1"
                      Stroke="#30D158"
                      StrokeThickness="2.2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 2. Full Expanded Draggable Toolbar Pill -->
        <Border x:Name="FullToolbarPill"
                Background="#F5181A20"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                CornerRadius="18"
                Padding="6,3"
                MouseDown="FullToolbarPill_MouseDown"
                MouseMove="FullToolbarPill_MouseMove"
                MouseUp="FullToolbarPill_MouseUp"
                Cursor="SizeWE"
                Visibility="Visible">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.75" Color="#000000" />
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Move / Drag Grip Handle -->
                <Border x:Name="DragGrip"
                        ToolTip="Drag horizontally left/right along the window titlebar"
                        Background="Transparent"
                        Padding="6,6"
                        Cursor="SizeWE"
                        MouseDown="DragGrip_MouseDown">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M1,2 A1,1 0 1,1 1,4 A1,1 0 1,1 1,2 M1,7 A1,1 0 1,1 1,9 A1,1 0 1,1 1,7 M1,12 A1,1 0 1,1 1,14 A1,1 0 1,1 1,12"
                              Fill="#888888" Width="4" Height="16" />
                        <Path Data="M1,2 A1,1 0 1,1 1,4 A1,1 0 1,1 1,2 M1,7 A1,1 0 1,1 1,9 A1,1 0 1,1 1,7 M1,12 A1,1 0 1,1 1,14 A1,1 0 1,1 1,12"
                              Fill="#888888" Width="4" Height="16" Margin="2,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- Pin / Always-on-Top Button -->
                <Button x:Name="BtnTopmost"
                        ToolTip="Always-on-Top (Alt+Z) - Outlines window in red"
                        Click="BtnTopmost_Click"
                        Padding="8,5"
                        Margin="2,0"
                        Background="#26FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Pin Vector Path -->
                        <Path Data="M9,2 L7,4 L7,8 L4,11 L4,12 L8,12 L8,16 L9,17 L10,16 L10,12 L14,12 L14,11 L11,8 L11,4 L9,2 Z"
                              Fill="White" Width="14" Height="15" Stretch="Uniform" />
                        <Ellipse x:Name="DotTopmost"
                                 Width="6" Height="6"
                                 Fill="#FF3B30"
                                 Margin="5,0,0,0"
                                 Visibility="Collapsed" />
                    </StackPanel>
                </Button>

                <!-- Opacity Button / Percentage Display -->
                <Button x:Name="BtnOpacity"
                        ToolTip="Transparency (Alt+A) - Click to cycle or scroll mouse wheel"
                        Click="BtnOpacity_Click"
                        MouseWheel="BtnOpacity_MouseWheel"
                        Padding="8,5"
                        Margin="2,0"
                        Background="#26FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Layered Windows Vector Path -->
                        <Path Data="M0,4 A2,2 0 0,1 2,2 L10,2 A2,2 0 0,1 12,4 L12,12 A2,2 0 0,1 10,14 L2,14 A2,2 0 0,1 0,12 Z M4,0 A2,2 0 0,1 6,0 L14,0 A2,2 0 0,1 16,2 L16,10 A2,2 0 0,1 14,12"
                              Stroke="White" StrokeThickness="1.2" Fill="Transparent" Width="15" Height="14" Stretch="Uniform" />
                        <TextBlock x:Name="TxtOpacityPercent"
                                   Text="100%"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#4CC2FF"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Hover Opacity Reveal Toggle Button (DisableWhenMouseAbove) -->
                <Button x:Name="BtnHoverOpacity"
                        ToolTip="Hover Opacity Reveal: Auto-restore 100% opacity when mouse is over window body (Click to Toggle ON/OFF)"
                        Click="BtnHoverOpacity_Click"
                        Padding="7,5"
                        Margin="2,0"
                        Background="#26FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Eye Vector Path -->
                        <Path Data="M0,7 C2,2 10,2 12,7 C10,12 2,12 0,7 Z M6,4.5 A2.5,2.5 0 1,1 6,9.5 A2.5,2.5 0 1,1 6,4.5 Z"
                              Stroke="White" StrokeThickness="1.2" Fill="Transparent" Width="14" Height="13" Stretch="Uniform" />
                        <Ellipse x:Name="DotHoverOpacity"
                                 Width="6" Height="6"
                                 Fill="#30D158"
                                 Margin="4,0,0,0"
                                 Visibility="Visible" />
                    </StackPanel>
                </Button>

                <!-- Click-Through Toggle Button -->
                <Button x:Name="BtnClickThrough"
                        ToolTip="Click-Through Mode (Alt+C) - Mouse passes through window. Click to disable!"
                        Click="BtnClickThrough_Click"
                        Padding="8,5"
                        Margin="2,0"
                        Background="#26FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Cursor Click Vector Path -->
                        <Path Data="M0,0 L0,14 L4,10 L7,16 L9,15 L6,9 L11,9 Z"
                              Fill="White" Width="12" Height="14" Stretch="Uniform" />
                        <TextBlock x:Name="TxtClickThroughStatus"
                                   Text="ON"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#30D158"
                                   Margin="4,0,0,0"
                                   Visibility="Collapsed" />
                        <Ellipse x:Name="DotClickThrough"
                                 Width="6" Height="6"
                                 Fill="#30D158"
                                 Margin="5,0,0,0"
                                 Visibility="Collapsed" />
                    </StackPanel>
                </Button>

                <Separator Width="1" Height="16" Margin="4,0" Background="#33FFFFFF" />

                <!-- Picture-in-Picture Button -->
                <Button x:Name="BtnPip"
                        ToolTip="Picture-in-Picture (Alt+Q) - Shrinks into live stream &amp; hides main window"
                        Click="BtnPip_Click"
                        Padding="8,5"
                        Margin="2,0"
                        Background="#26FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand">
                    <!-- PiP Screen in Screen Vector Path -->
                    <Path Data="M0,2 A2,2 0 0,1 2,0 L16,0 A2,2 0 0,1 18,2 L18,12 A2,2 0 0,1 16,14 L2,14 A2,2 0 0,1 0,12 Z M8,7 L16,7 L16,12 L8,12 Z"
                          Fill="White" Width="16" Height="13" Stretch="Uniform" />
                </Button>

                <!-- Crop to PiP Button -->
                <Button x:Name="BtnCrop"
                        ToolTip="Crop Region to PiP - Select sub-rectangle to stream"
                        Click="BtnCrop_Click"
                        Padding="8,5"
                        Margin="2,0"
                        Background="#26FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand">
                    <!-- Crop Tool Vector Path -->
                    <Path Data="M4,0 L4,12 L16,12 M0,4 L12,4 L12,16"
                          Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
                </Button>

                <!-- Dark Mode Inversion Button -->
                <Button x:Name="BtnDarkMode"
                        ToolTip="Inverted Dark Mode (Alt+D) - Hardware GPU color inversion"
                        Click="BtnDarkMode_Click"
                        Padding="8,5"
                        Margin="2,0"
                        Background="#26FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Crescent Moon Vector Path -->
                        <Path Data="M10,0 A8,8 0 1,1 0,10 A6,6 0 0,0 10,0 Z"
                              Fill="White" Width="13" Height="13" Stretch="Uniform" />
                        <Ellipse x:Name="DotDarkMode"
                                 Width="6" Height="6"
                                 Fill="#FFD60A"
                                 Margin="5,0,0,0"
                                 Visibility="Collapsed" />
                    </StackPanel>
                </Button>

                <Separator Width="1" Height="16" Margin="4,0" Background="#33FFFFFF" />

                <!-- Settings Button (Directly on Toolbar!) -->
                <Button x:Name="BtnSettings"
                        ToolTip="Open OpenWindow Settings Dashboard"
                        Click="BtnSettings_Click"
                        Padding="7,5"
                        Margin="2,0"
                        Background="#26FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand">
                    <!-- Gear Vector Path -->
                    <Path Data="M6.5,0 L8.5,0 L8.8,2.2 A6.5,6.5 0 0,1 10.3,3.1 L12.4,2.2 L13.8,3.6 L12.9,5.7 A6.5,6.5 0 0,1 13.8,7.2 L16,7.5 L16,9.5 L13.8,9.8 A6.5,6.5 0 0,1 12.9,11.3 L13.8,13.4 L12.4,14.8 L10.3,13.9 A6.5,6.5 0 0,1 8.8,14.8 L8.5,17 L6.5,17 L6.2,14.8 A6.5,6.5 0 0,1 4.7,13.9 L2.6,14.8 L1.2,13.4 L2.1,11.3 A6.5,6.5 0 0,1 1.2,9.8 L-1,9.5 L-1,7.5 L1.2,7.2 A6.5,6.5 0 0,1 2.1,5.7 L1.2,3.6 L2.6,2.2 L4.7,3.1 A6.5,6.5 0 0,1 6.2,2.2 Z M7.5,5.5 A3,3 0 1,0 7.5,11.5 A3,3 0 1,0 7.5,5.5 Z"
                          Fill="#4CC2FF" Width="13" Height="13" Stretch="Uniform" />
                </Button>

                <!-- Collapse to Header Handle Button -->
                <Button x:Name="BtnCollapse"
                        ToolTip="Collapse to top header anchor"
                        Click="BtnCollapse_Click"
                        Padding="6,5"
                        Margin="2,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <!-- Chevron Up Vector -->
                    <Path Data="M0,4 L4,0 L8,4" Stroke="#AAAAAA" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                </Button>

                <!-- Dismiss Toolbar Button -->
                <Button x:Name="BtnClose"
                        ToolTip="Dismiss toolbar for this window"
                        Click="BtnClose_Click"
                        Padding="6,5"
                        Margin="2,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#888888" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="8" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Horizontal Opacity Slider Popup (Windows 11 Volume / Brightness Style) -->
        <Popup x:Name="PopupOpacitySlider"
               PlacementTarget="{Binding ElementName=BtnOpacity}"
               Placement="Bottom"
               VerticalOffset="6"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Background="#F21E2433"
                    BorderBrush="#44FFFFFF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,10"
                    Width="240">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- Header with Icon & Percentage -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M0,4 A2,2 0 0,1 2,2 L10,2 A2,2 0 0,1 12,4 L12,12 A2,2 0 0,1 10,14 L2,14 A2,2 0 0,1 0,12 Z M4,0 A2,2 0 0,1 6,0 L14,0 A2,2 0 0,1 16,2 L16,10 A2,2 0 0,1 14,12"
                                  Stroke="#4CC2FF" StrokeThickness="1.2" Fill="Transparent" Width="14" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Window Opacity" FontSize="11" FontWeight="SemiBold" Foreground="#E0E2E6" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="TxtSliderPercentBadge" Text="100%" FontSize="12" FontWeight="Bold" Foreground="#4CC2FF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Horizontal Slider (5 to 100%) -->
                    <Slider Grid.Row="1"
                            x:Name="SliderOpacity"
                            Minimum="5"
                            Maximum="100"
                            Value="100"
                            SmallChange="5"
                            LargeChange="10"
                            IsSnapToTickEnabled="False"
                            ValueChanged="SliderOpacity_ValueChanged"
                            Cursor="Hand"
                            Height="24"
                            Margin="0,2,0,8" />

                    <!-- Quick Preset Badges -->
                    <UniformGrid Grid.Row="2" Columns="5" Margin="0,2,0,0">
                        <Button Content="20%" Click="BtnPresetOpacity_Click" Tag="20" Background="#26FFFFFF" Foreground="#CCCCCC" BorderThickness="0" FontSize="10" Padding="0,4" Margin="1,0" Cursor="Hand" />
                        <Button Content="40%" Click="BtnPresetOpacity_Click" Tag="40" Background="#26FFFFFF" Foreground="#CCCCCC" BorderThickness="0" FontSize="10" Padding="0,3" Margin="1,0" Cursor="Hand" />
                        <Button Content="60%" Click="BtnPresetOpacity_Click" Tag="60" Background="#26FFFFFF" Foreground="#CCCCCC" BorderThickness="0" FontSize="10" Padding="0,3" Margin="1,0" Cursor="Hand" />
                        <Button Content="80%" Click="BtnPresetOpacity_Click" Tag="80" Background="#26FFFFFF" Foreground="#CCCCCC" BorderThickness="0" FontSize="10" Padding="0,3" Margin="1,0" Cursor="Hand" />
                        <Button Content="100%" Click="BtnPresetOpacity_Click" Tag="100" Background="#26FFFFFF" Foreground="#CCCCCC" BorderThickness="0" FontSize="10" Padding="0,3" Margin="1,0" Cursor="Hand" />
                    </UniformGrid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
